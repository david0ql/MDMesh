# DallyControl deployment config. Copy to .env (or let ./setup.sh generate it) and fill in.
# .env is gitignored — it holds secrets. Generated secrets should be alphanumeric.

# --- Database (not published to the host) ---
DB_NAME=dallycontrol
DB_USER=dallycontrol
# REQUIRED. Generate, e.g.: openssl rand -hex 24
DB_PASSWORD=

# --- Server ---
# REQUIRED. Public base URL devices + the console use (no trailing slash). This is also embedded in
# the enrollment QR so agents know where to reach. e.g. https://mdm.example.com  or  https://mdm.acme.dev
BASE_URL=
# REQUIRED. Shared signing secret. Generate, e.g.: openssl rand -hex 24
HASH_SECRET=
# Optional. Signs the JWTs of REST API clients (/rest/public/jwt/login). Leave empty: the server generates a key once
# and keeps it in its data volume (/opt/dallycontrol/jwt.secret), so those clients stay signed in across restarts. Set it
# only to pin a key of your own: hex, a multiple of 4 characters, at least 128, e.g. openssl rand -hex 64
# (anything else is refused at start; the JWT library would silently drop characters). The server gets it as
# JWT_SECRET.
SERVER_JWT_SECRET=
# 1 = require signed enrollment (more secure; needs the secret on the agent too). 0 = off.
SECURE_ENROLLMENT=0

# --- Edge (Caddy) ---
# own-domain  → SITE_ADDRESS=mdm.example.com  (Caddy gets a Let's Encrypt cert; set ACME_EMAIL)
# cloudflare  → SITE_ADDRESS=:80              (Cloudflare terminates TLS)
SITE_ADDRESS=:80
ACME_EMAIL=

# --- Cloudflare Tunnel (only the cloudflare profile) ---
# Create a tunnel in Cloudflare Zero Trust, route its public hostname to http://caddy:80, and paste
# the tunnel token here. Then: docker compose --profile cloudflare up -d
TUNNEL_TOKEN=

# --- Auto-update (updater/recovery supervisor) ---
# The GitHub repo to poll for releases (owner/name), the channel, and this deployment's current
# version (set to the deployed release tag; 0.0.0 means "any release shows as available").
GITHUB_REPO=
UPDATE_CHANNEL=stable
POLL_INTERVAL_HOURS=6
CURRENT_VERSION=0.0.0
# Optional GitHub token to raise the API rate limit / read a private repo.
GITHUB_TOKEN=

# --- SMTP (optional; password-recovery, alert and report emails) ---
# Typical provider: SMTP_PORT=587 + SMTP_STARTTLS=true, or SMTP_PORT=465 + SMTP_SSL=true, with user and password.
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=mdm@localhost
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false

# =====================================================================================================================
# Operación: estabilidad, monitoreo, respaldos y alta disponibilidad (docs/ops/). Todo es opcional y está apagado
# por defecto: una instalación existente no cambia hasta que se activan los perfiles y variables de abajo.
# Perfiles de compose (se suman a los que ya tenga, separados por comas):
#   COMPOSE_PROFILES=cloudflare,remote,monitor,backup,cloudflare-replica
# =====================================================================================================================

# --- Límites de recursos (servidor compartido) ---
# 0 o vacío = sin límite (comportamiento anterior). Valores recomendados para convivir con otros productos; antes de
# activarlos mida el consumo real con `docker stats` durante un día normal y deje al menos un 30 % de margen.
# La JVM usa por defecto el 25 % de la memoria del contenedor: con límite, fije también el porcentaje de heap.
#SERVER_MEM_LIMIT=2g
#SERVER_CPUS=2.0
#SERVER_JAVA_OPTS=-XX:MaxRAMPercentage=60
#POSTGRES_MEM_LIMIT=1g
#POSTGRES_CPUS=2.0
#POSTGRES_SHM_SIZE=128m
#CADDY_MEM_LIMIT=256m
#CADDY_CPUS=1.0
#SUPERVISOR_MEM_LIMIT=256m
#SUPERVISOR_CPUS=0.5
#CLOUDFLARED_MEM_LIMIT=256m
#CLOUDFLARED_CPUS=0.5
# Cuánto espera una petición a que haya una instancia del servidor saludable antes de mostrar la página de recuperación.
#LB_TRY_DURATION=20s

# --- Monitoreo y alertas (perfil `monitor`; docs/ops/MONITOREO.md) ---
# Zona horaria de los servicios de operación (horas de los avisos, hora del respaldo, corte mensual de disponibilidad).
OPS_TZ=America/Bogota
MONITOR_SERVICE_NAME=DallyControl
MONITOR_INTERVAL_SECONDS=60
# URL EXTERNA que se comprueba cada minuto (la que usan los equipos, pasando por Cloudflare). Vacío = no se comprueba.
# Es la que define la disponibilidad mensual publicada. Ejemplo: https://mdm.ejemplo.com/healthz/deep
MONITOR_PUBLIC_URL=
# Estado del túnel: el /ready de cada conector cloudflared (separados por comas). Vacío = sin túnel.
# Un conector: http://cloudflared:20241/ready      Con réplica: http://cloudflared:20241/ready,http://cloudflared-2:20241/ready
MONITOR_TUNNEL_URLS=
# Espacio en disco: avisa cuando un volumen supera este porcentaje.
MONITOR_DISK_WARN_PERCENT=85
# Antigüedad máxima del último respaldo correcto, en horas (0 = no vigilar). Con respaldo diario: 26.
MONITOR_BACKUP_MAX_AGE_HOURS=0
# Equipos en línea: un equipo cuenta si reportó en los últimos N minutos (el agente reporta cada 15). Se avisa cuando
# la cantidad cae un X % o más respecto de la última hora (incidente de comunicación). 0 en MONITOR_DEVICES lo apaga.
MONITOR_DEVICES=1
MONITOR_DEVICES_ONLINE_MINUTES=30
MONITOR_DEVICES_DROP_PERCENT=40
MONITOR_DEVICES_MIN_FLEET=5
# Antirrebote: fallas seguidas para avisar, aciertos seguidos para avisar la recuperación, recordatorio mientras dure.
MONITOR_FAIL_AFTER=2
MONITOR_RECOVER_AFTER=2
MONITOR_REMINDER_MINUTES=60
# 1 = publica la página de estado en <BASE_URL>/estado (y /estado.json) para compartir con el cliente. 0 = oculta.
MONITOR_STATUS_PUBLIC=1
# Canales de alerta (puede usar varios a la vez). Correo: lista separada por comas; si ALERT_SMTP_* queda vacío se usa
# el SMTP de arriba (SMTP_HOST...). ALERT_SMTP_TLS: auto (STARTTLS si el servidor lo ofrece) | ssl (puerto 465) | off.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_TLS=auto
# Webhook genérico: recibe un POST JSON {"text": "..."} (el formato de los webhooks entrantes de Slack, Mattermost
# y Google Chat).
ALERT_WEBHOOK_URL=
# Telegram: token del bot (@BotFather) y id del chat o grupo.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# --- Respaldos (perfil `backup`; docs/ops/RESPALDOS.md) ---
# Hora local del respaldo diario (HH:MM, zona OPS_TZ).
BACKUP_TIME=02:30
# Retención: los N más recientes, más el último de cada una de las últimas N semanas y de los últimos N meses.
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
# 1 = respalda también los archivos subidos (APKs, íconos, archivos de configuración).
BACKUP_FILES=1
# Restauración de prueba automática en una base temporal: always (cada respaldo) | weekly (domingos) | never.
BACKUP_VERIFY_RESTORE=weekly
# Cifrado (recomendado si el respaldo sale del servidor). Con frase, los volcados se guardan cifrados (AES-256) y se
# incluye una copia cifrada de .env. GUARDE LA FRASE FUERA DEL SERVIDOR: sin ella el respaldo no se puede leer.
BACKUP_ENCRYPTION_PASSPHRASE=
# Copia fuera del servidor: elija UNA opción.
# (a) Almacenamiento compatible con S3 (AWS S3, Cloudflare R2, Backblaze B2, MinIO, Wasabi...):
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=dallycontrol
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# (b) Cualquier destino de rclone (Google Drive, SFTP, Azure...): nombre:ruta, con ops/backup-config/rclone.conf
BACKUP_RCLONE_REMOTE=
# (c) rsync por SSH a otro servidor: usuario@host:/ruta, con ops/backup-config/id_ed25519 y known_hosts
BACKUP_RSYNC_TARGET=
# 1 = el respaldo se considera fallido (y el monitor avisa) si la copia externa falla.
BACKUP_REMOTE_REQUIRED=0

# --- Alta disponibilidad: servidor en espera con réplica de PostgreSQL (docs/ops/ALTA-DISPONIBILIDAD.md) ---
# En el servidor principal (con docker-compose.ha-primary.yml en COMPOSE_FILE): dirección PRIVADA por la que se
# conecta el servidor en espera (VPN/WireGuard). Nunca una dirección pública.
#PG_REPL_BIND=10.8.0.1
#PG_REPL_PORT=5432
# En ambos: usuario, clave (openssl rand -hex 24) y ranura de replicación.
#REPLICATION_USER=replicator
#REPLICATION_PASSWORD=
#REPLICATION_SLOT=dallycontrol_standby
# En el servidor en espera (con docker-compose.ha-standby.yml en COMPOSE_FILE): dónde está el principal.
#PRIMARY_HOST=10.8.0.1
#PRIMARY_PORT=5432
