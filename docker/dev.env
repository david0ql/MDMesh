# Dev-only values for the dev stack (docker-compose.yml + docker-compose.dev.yml). NOT secrets: never use them on a
# reachable host. Pass this file on EVERY compose command for the dev stack. It replaces .env, so a production .env
# in the same checkout is never read:
#   docker compose --env-file docker/dev.env up -d --build
# Variables exported in your shell override these (compose's rule), e.g. DEV_API_PORT=18080.
DALLYCONTROL_DEV=1
COMPOSE_PROJECT_NAME=dallycontrol-dev
# ':' separates COMPOSE_FILE entries on every OS (compose's default on Windows is ';').
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
DB_PASSWORD=dallycontrol
HASH_SECRET=dev-only-insecure
# The console's address; the server puts it in enrollment QR codes and links. Moved DEV_WEB_PORT? Change it too.
BASE_URL=http://localhost:8088
# Own image tags, so a dev build never replaces the images a source install on the same host runs.
SERVER_VERSION=dev
WEB_VERSION=dev
SUPERVISOR_VERSION=dev
# Inert supervisor: no release polling, no one-click apply.
GITHUB_REPO=
APPLY_SUPPORTED=0
# Remote control services (vnc-repeater + websockify + websockify-device), repeater on loopback only (an emulator reaches it at
# 10.0.2.2:5500).
COMPOSE_PROFILES=remote
REPEATER_BIND=127.0.0.1
REPEATER_VERSION=dev
